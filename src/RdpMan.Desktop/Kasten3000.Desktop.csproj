<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Kasten3000</AssemblyName>
    <RootNamespace>RdpMan.Desktop</RootNamespace>
    <Version>0.1.17</Version>
    <Authors>SANDAV</Authors>
    <DefineConstants>KASTEN3000</DefineConstants>
    <ApplicationIcon>AssetsKasten\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.DirectoryServices" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="AssetsKasten\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Assets\app.ico</TargetPath>
    </Content>
    <Content Include="AssetsKasten\app-logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Assets\app-logo.png</TargetPath>
    </Content>
  </ItemGroup>
</Project>
